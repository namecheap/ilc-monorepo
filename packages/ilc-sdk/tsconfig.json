{
    // Package-wide options; the project configs below extend this file.
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // Published as CommonJS: there is no `"type": "module"` in package.json, and this flag would
        // force `import x = require()` syntax in CommonJS files.
        "verbatimModuleSyntax": false,
        // Not yet satisfied by the code that moved in from the ilc-sdk repo. Tighten in a follow-up.
        "exactOptionalPropertyTypes": false,
        "noUncheckedIndexedAccess": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "files": [],
    "references": [
        { "path": "./tsconfig.app.json" },
        { "path": "./tsconfig.server.json" },
        { "path": "./tsconfig.test.json" }
    ]
}
